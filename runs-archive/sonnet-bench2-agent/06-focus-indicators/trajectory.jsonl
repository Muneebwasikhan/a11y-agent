x; background: #22272e; color: #fff; border: 0; border-radius: 6px; font-size: 14px; cursor: pointer }\n  main { max-width: 640px; margin: 44px auto; padding: 0 24px; line-height: 1.65 }\n  h1 { font-size: 26px; margin: 0 0 12px }\n  p { color: #46505b; margin: 0 0 16px }\n  .banner { margin-top: 28px; padding: 18px 20px; background: #f2f6ff; border: 1px solid #d6e2fb; border-radius: 8px }\n  .banner button { padding: 10px 16px; background: #2456c4; color: #fff; border: 0; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer }\n</style>\n<script>\n  window.__activated = []\n  document.addEventListener('click', function (e) {\n    var hit = e.target instanceof Element ? e.target.closest('[data-track]') : null\n    var name = hit ? hit.getAttribute('data-track') : null\n    if (name) window.__activated.push(name)\n  })\n</script>\n</head>\n<body>\n<header>\n  <span class=\"logo\">Lumen</span>\n  <nav>\n    <a href=\"#guides\" data-track=\"nav-guides\">Guides</a>\n    <a href=\"#reference\" data-track=\"nav-reference\">Reference</a>\n  </nav>\n  <div class=\"search\">\n    <input type=\"search\" aria-label=\"Search the docs\" placeholder=\"Search the docs\">\n    <button type=\"button\" data-track=\"search-go\">Search</button>\n  </div>\n</header>\n<main>\n  <h1 id=\"guides\">Getting started</h1>\n  <p>Lumen ships as a single binary. Install it, point it at a folder of markdown, and it serves a documentation site with search built in.</p>\n  <p id=\"reference\">The reference section covers configuration keys, theming variables, and the plugin interface for custom renderers.</p>\n  <div class=\"banner\">\n    <p style=\"margin: 0 0 12px\">New in 2.4: offline search indexes and keyboard shortcuts.</p>\n    <button type=\"button\" data-track=\"whats-new\">See what changed</button>\n  </div>\n</main>\n</body>\n</html>\n","numLines":55,"startLine":1,"totalLines":55}}}
